# Copy this file to .env and fill in your real values. Never commit .env.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
PORT=3000

# Secret the water level sensor must send in the x-device-key header.
# Use a long random string (letters and numbers only).
DEVICE_KEY=change_me_to_a_long_random_string
